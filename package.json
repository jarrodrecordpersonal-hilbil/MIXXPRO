{
  "name": "mixxpro", "version": "0.2.0", "private": true, "type": "module",
  "engines": {"node": ">=22.16.0"},
  "scripts": {
    "start": "node --experimental-sqlite --env-file-if-exists=.env apps/server/main.mjs",
    "dev": "node --experimental-sqlite --env-file-if-exists=.env --watch apps/server/main.mjs",
    "test": "node --experimental-sqlite --test tests/*.test.mjs",
    "check": "node scripts/check.mjs", "build": "npm run check",
    "admin": "node --experimental-sqlite --env-file-if-exists=.env scripts/admin.mjs",
    "backup": "node --experimental-sqlite --env-file-if-exists=.env scripts/backup.mjs"
  }
}
