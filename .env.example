# Copy to .env locally. Never commit credentials. Use your deployment secret store.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
APP_SECRET=
DB_PATH=./data/mixxpro.sqlite
DEMO_MODE=false
# In production default is invite-only; enable only after your launch review.
SIGNUPS_ENABLED=true
# Trust only the dedicated reverse proxy's overwritten X-Real-IP header.
TRUST_PROXY=false
FREE_TV_LIMIT=5
# Commercial assumption deliberately unset: 0 means no commission accrual.
# Configure approved basis points before real orders (1000 = 10%).
COMMISSION_BPS=0

# Bunny Stream: server-side API access and separate advanced CDN token key.
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOST=
BUNNY_TOKEN_KEY=

# Cloudflare R2 private originals. Never use a public bucket for masters.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Stripe USD/month/per-unit/quantity prices, not invented amounts in the UI.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PAID=
STRIPE_PRICE_PREMIUM=
STRIPE_WEBHOOK_SECRET=

# Fixed merchant destination and signed settled-order webhook integration.
COMMERCE_URL=
COMMERCE_WEBHOOK_SECRET=
